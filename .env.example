# Copy to .env and fill in. NEVER commit .env. Keep every value below empty in this file.

# Absolute path OUTSIDE OneDrive and outside the repository, e.g. C:\data\openinspect
OPENINSPECT_DATA_DIR=

# EVREN (scripts/evren_inventory.py reads these from the environment only; it is read-only).
# Platform key (Settings > API keys, kind "platform"): training jobs, projects, datasets, models.
EVREN_PLATFORM_API_KEY=
# Model inference key (kind "model_inference"): models and inference only.
EVREN_MODEL_API_KEY=
# The web application, e.g. https://evren.ssyz.org.tr (links only).
EVREN_BASE_URL=
# Optional: the API host; the default is the official SDK's https://api.ssyz.org.tr/api/v1
EVREN_API_URL=
